{
  "manifest_version": 3,
  "name": "Right2Comment",
  "version": "1.1",
  "description": "Gain Freedom of comments on YouTube.",
  "icons": {
    "48": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "right2comment@example.com"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "host_permissions": [
    "https://right2comment.vercel.app/*"
  ],
  "permissions": []
}
